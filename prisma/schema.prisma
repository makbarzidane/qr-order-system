generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Phase 1.5: Simplified flat schema ──────────────────────────────────────
// Items stored as JSON in Order.itemsJson (avoids join complexity for Phase 1.5)
// Phase 2 will normalize into proper OrderItem table + add Decimal precision

model Order {
  id            String    @id
  orderNumber   String    @unique
  customerName  String
  tableId       String    @default("")
  status        String    @default("PENDING_PAYMENT")
  paymentStatus String    @default("UNPAID")
  paymentMethod String
  itemsJson     String    // JSON: OrderItem[]
  subtotal      Float     @default(0)
  total         Float     @default(0)
  queueNumber   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  paidAt        DateTime?

  @@index([paymentStatus])
  @@index([status])
  @@index([createdAt])
}

// Daily queue counter — reset every day
model QueueCounter {
  dateKey String @id
  counter Int    @default(0)
}
